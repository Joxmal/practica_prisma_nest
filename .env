
# variables de DB
POSTGRES_USER=prisma
POSTGRES_PASSWORD=topsecret
POSTGRES_DB=food
POSTGRES_PORT=5432

# variables de backend
PORT=3000
HOST_API=http://localhost:3000/api


# descomentar para dockerizar
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=food&sslmode=prefer
DATABASE_URL="postgresql://prisma:topsecret@localhost:5432/food?schema=food&sslmode=prefer"





